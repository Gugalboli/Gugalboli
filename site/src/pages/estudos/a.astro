---
import Base from '../../layouts/Base.astro';
import c from '../../content/abertura.pt.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const artText = [
  'Uma alavanca feita de pontos apoiada num triângulo vermelho sólido. Na ponta longa, uma pequena figura humana (o esforço); na ponta curta, uma esfera grande de pontos (o efeito). Mover o apoio para perto do efeito aumenta a esfera sem mudar a figura.',
  'O triângulo vermelho vira um cone de luz. Sob ele, os pontos formam um bloco organizado; fora dele, ficam dispersos.',
  'Duas margens cinzas, rotuladas negócio e técnica, e uma passagem de pontos construída entre elas, apoiada num pilar vermelho. Uma figura atravessa.',
  'Três placas de pontos empilhadas sobre uma base vermelha, ao lado de uma figura; um fluxo de pontos sai para a direita, rotulado em uso.',
  'Os pontos formam um anel com uma seta vermelha; no centro, uma grade densa de pontos acumulados.',
];
---
<Base title="Estudo A — O ponto de apoio · Gustavo Albuquerque">
  <main id="conteudo">
    <section class="story" data-story>
      <div class="stage" aria-hidden="false">
        <canvas class="art" role="img" aria-label={artText[0]} data-art></canvas>
        <div class="labels" aria-hidden="true" data-labels></div>
        <nav class="rail" aria-label="Capítulos da ideia">
          <a href="#abertura" data-rail="0"><span>00</span> Alavancagem</a>
          {c.capitulos.map((k, i) => <a href={`#cap-${k.n}`} data-rail={i + 1}><span>{k.n}</span> {k.titulo}</a>)}
        </nav>
      </div>

      <div class="track">
        <header class="hero" id="abertura" data-block="0">
          <div class="mast">
            <p class="eyebrow">Estudo A · O ponto de apoio</p>
            <h1 class="name serif">{c.nome}</h1>
            <p class="role">{c.atuacao} · {c.local}</p>
          </div>

          {c.sinteses.map((s, i) => (
            <a class={`syn syn-${i}`} href={s.href}>
              <span class="eyebrow">{s.rotulo}</span>
              <span class="syn-t">{s.texto}</span>
            </a>
          ))}

          <div class="thesis">
            <p class="def serif">{c.definicao}</p>
            <p class="formula"><span class="serif expr">{c.formula.expr}</span> <span>{c.formula.legenda}</span></p>
            <p class="illus fonte">{c.formula.fonte}</p>
            <div class="control">
              <label for="apoio" class="mono">Mova o apoio</label>
              <input id="apoio" type="range" min="0" max="100" value="68" data-apoio aria-describedby="leitura" />
              <output id="leitura" class="mono" aria-live="polite" data-leitura>Apoio perto do efeito: o mesmo esforço move muito mais.</output>
            </div>
            <p class="cta">
              <a class="btn btn--ink" href={`${base}/estudos/mermaid`}>Ver uma entrega</a>
              <a class="btn" href={`mailto:${c.contato.email}`}>Conversar por email</a>
              <a class="btn" href={c.contato.linkedin} rel="me noopener">LinkedIn</a>
            </p>
          </div>
        </header>

        {c.capitulos.map((k, i) => (
          <article class="chapter" id={`cap-${k.n}`} data-block={i + 1}>
            <div class="card">
              <p class="eyebrow"><span class="num">{k.n}</span> {k.titulo}</p>
              <h2 class="serif">{k.frase}</h2>
              <p>{k.texto}</p>
              <p class="visually-hidden">Ilustração: {artText[i + 1]}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="after">
      <p class="eyebrow">Fim do protótipo da abertura</p>
      <p class="serif big">Na versão completa, aqui começam as quatro entregas em uso.</p>
      <p><a href={`${base}/estudos/mermaid`}>Ver a cena de entrega (tradutor de transcrições) →</a> · <a href={`${base}/`}>Voltar aos estudos</a></p>
    </section>
  </main>
</Base>

<style>
  .story { position: relative; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .art { width: 100%; height: 100%; touch-action: pan-y; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .labels :global(span) {
    position: absolute; left: 0; top: 0; font: 500 0.72rem/1 var(--mono); letter-spacing: .04em; text-transform: uppercase;
    color: var(--ink-3); white-space: nowrap; will-change: transform, opacity;
  }
  .labels :global(span.ink) { color: var(--ink); }
  .labels :global(span.red) { color: var(--red); }

  .rail {
    position: absolute; left: var(--gutter); bottom: 24px; display: flex; flex-direction: column; gap: 4px;
    font: 0.72rem/1.3 var(--mono); letter-spacing: .03em; opacity: 0; transition: opacity .4s var(--ease);
  }
  .story.in-chapters .rail { opacity: 1; }
  .rail a { text-decoration: none; color: var(--ink-3); display: flex; gap: 8px; align-items: center; }
  .rail a span { display: inline-block; width: 2.2em; }
  .rail a[aria-current='step'] { color: var(--ink); font-weight: 500; }
  .rail a[aria-current='step'] span { color: var(--red); }
  .rail a[aria-current='step']::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--red); margin-left: -14px; }

  .track { position: relative; margin-top: -100svh; pointer-events: none; }
  .track :global(a), .track :global(input), .track :global(label), .track .card, .track .syn { pointer-events: auto; }

  /* ---------- Abertura ---------- */
  .hero {
    min-height: 100svh; padding: 20px var(--gutter) 28px;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto 1fr auto; column-gap: 24px;
    grid-template-areas:
      'mast mast mast'
      's0 art s1'
      '. art .'
      's2 art s3'
      'th th th';
  }
  .mast { grid-area: mast; text-align: center; }
  .mast .eyebrow { margin: 0 0 6px; }
  .name { font-size: var(--step-3); font-weight: 400; line-height: 1; margin: 0; letter-spacing: -0.015em; }
  .role { margin: 8px 0 0; color: var(--ink-2); font-size: var(--step--1); }
  .syn { text-decoration: none; display: flex; flex-direction: column; gap: 6px; max-width: 30ch; padding: 12px 0; border-top: 1px solid var(--line); transition: border-color .3s; }
  .syn:hover { color: inherit; border-color: var(--red); }
  .syn:hover .eyebrow { color: var(--red); }
  .syn-t { font-size: 0.92rem; line-height: 1.45; color: var(--ink-2); }
  .syn-0 { grid-area: s0; align-self: start; margin-top: 4vh; }
  .syn-1 { grid-area: s1; align-self: start; justify-self: end; margin-top: 4vh; text-align: right; }
  .syn-2 { grid-area: s2; align-self: end; }
  .syn-3 { grid-area: s3; align-self: end; justify-self: end; text-align: right; }

  .thesis { grid-area: th; text-align: center; display: grid; justify-items: center; gap: 6px; }
  .def { font-size: var(--step-2); line-height: 1.1; margin: 0; font-weight: 400; }
  .formula { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .expr { font-size: 1.25rem; font-style: italic; color: var(--ink); margin-right: .4em; }
  .fonte { margin: 0; }
  .control { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: center; margin-top: 4px; }
  .control label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .04em; }
  .control output { font-size: 0.75rem; color: var(--ink-2); min-width: 34ch; text-align: left; }
  input[type='range'] { accent-color: var(--red); width: 160px; }
  .cta { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 8px 0 0; }
  .btn { font: 500 0.88rem/1 var(--sans); text-decoration: none; border: 1px solid var(--ink); border-radius: 999px; padding: 11px 16px; transition: background .2s, color .2s; }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn--ink { background: var(--ink); color: var(--paper); }
  .btn--ink:hover { background: var(--red); border-color: var(--red); }

  /* ---------- Capítulos ---------- */
  .chapter { min-height: 125svh; display: flex; align-items: center; padding: 0 var(--gutter); }
  .card { max-width: 40ch; margin-left: clamp(0px, 4vw, 80px); }
  .card h2 { font-size: var(--step-3); line-height: 1.04; font-weight: 400; margin: 10px 0 16px; letter-spacing: -0.01em; }
  .card p:last-of-type { color: var(--ink-2); }
  .num { color: var(--red); }
  :global(html.js) .card > * { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  :global(html.js) .chapter.is-active .card > * { opacity: 1; transform: none; }
  :global(html.js) .chapter.is-active .card > :nth-child(2) { transition-delay: .12s; }
  :global(html.js) .chapter.is-active .card > :nth-child(3) { transition-delay: .3s; }

  .after { min-height: 60svh; padding: 15vh var(--gutter); max-width: 900px; margin: 0 auto; text-align: center; }
  .big { font-size: var(--step-2); line-height: 1.15; }

  @media (max-width: 759px) {
    .hero {
      grid-template-columns: 1fr 1fr; grid-template-rows: auto minmax(260px, 44svh) auto auto auto; row-gap: 0; column-gap: 16px;
      grid-template-areas: 'mast mast' 'art art' 'th th' 's0 s1' 's2 s3';
      min-height: auto;
      padding-top: 16px;
    }
    .mast { text-align: left; }
    .syn, .syn-1, .syn-3 { text-align: left; justify-self: start; align-self: start; margin-top: 0; }
    .syn-t { font-size: 0.85rem; }
    .thesis { padding-bottom: 12px; }
    .control output { min-width: 0; text-align: center; }
    .chapter { align-items: flex-start; padding-top: 32svh; min-height: 115svh; }
    .hero + .chapter { margin-top: 50svh; }
    .card { background: var(--paper); padding: 16px var(--gutter) 20px; margin: 0 calc(-1 * var(--gutter)); max-width: none; border-top: 1px solid var(--line); }
    .card h2 { font-size: var(--step-2); }
    .rail { display: none; }
  }
</style>

<script>
  import { DotField, labelLayer } from '../../lib/dots';
  import { scenesA, leverState, geo } from '../../lib/scenes-a';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-art]')!;
  const labelsEl = document.querySelector<HTMLElement>('[data-labels]')!;
  const story = document.querySelector<HTMLElement>('[data-story]')!;
  const artText = [...document.querySelectorAll('.chapter .visually-hidden')].map((p) => p.textContent!.replace('Ilustração: ', ''));
  const art0 = canvas.getAttribute('aria-label')!;

  const field = new DotField(canvas, scenesA, {
    onLabels: labelLayer(labelsEl),
  });
  field.setStill(document.documentElement.classList.contains('still'));
  addEventListener('motionchange', (e) => field.setStill((e as CustomEvent).detail));

  /* ---- alavanca: controle acessível + arrastar no desenho ---- */
  const range = document.querySelector<HTMLInputElement>('[data-apoio]')!;
  const out = document.querySelector<HTMLOutputElement>('[data-leitura]')!;
  const readout = (f: number) =>
    f < 0.34 ? 'Apoio perto do esforço: o mesmo esforço move pouco.'
    : f < 0.67 ? 'Apoio no meio: o efeito cresce com a alavancagem.'
    : 'Apoio perto do efeito: o mesmo esforço move muito mais.';
  const setF = (f: number) => {
    leverState.f = Math.max(0, Math.min(1, f));
    range.value = String(Math.round(leverState.f * 100));
    out.textContent = readout(leverState.f);
    field.rebuild(0);
  };
  range.addEventListener('input', () => setF(+range.value / 100));
  let dragging = false;
  const fFromX = (x: number) => {
    const { cx, s } = geo(canvas.clientWidth, canvas.clientHeight, false);
    const L = 620 * s, x0 = cx - L / 2;
    return ((x - x0) / L - 0.34) / 0.5;
  };
  const nearLever = (y: number) => {
    const { cy, s } = geo(canvas.clientWidth, canvas.clientHeight, false);
    return y > cy - 120 * s && y < cy + 130 * s;
  };
  canvas.addEventListener('pointerdown', (e) => {
    if (progress > 0.3) return;
    const r = canvas.getBoundingClientRect();
    if (!nearLever(e.clientY - r.top)) return;
    dragging = true; canvas.setPointerCapture(e.pointerId); setF(fFromX(e.clientX - r.left));
  });
  canvas.addEventListener('pointermove', (e) => { if (dragging) setF(fFromX(e.clientX - canvas.getBoundingClientRect().left)); });
  canvas.addEventListener('pointerup', () => (dragging = false));
  canvas.addEventListener('pointercancel', () => (dragging = false));
  // as camadas de texto ficam sobre o canvas; o arrasto vale também a partir delas
  document.querySelector('.hero')!.addEventListener('pointerdown', (e) => {
    const pe = e as PointerEvent;
    if ((pe.target as HTMLElement).closest('a, input, label, button')) return;
    const r = canvas.getBoundingClientRect();
    const y = pe.clientY - r.top;
    if (!nearLever(y)) return;
    dragging = true; setF(fFromX(pe.clientX - r.left));
    const move = (m: PointerEvent) => dragging && setF(fFromX(m.clientX - r.left));
    const up = () => { dragging = false; removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
    addEventListener('pointermove', move); addEventListener('pointerup', up);
  });

  /* ---- rolagem → cena (com patamares: cada estado fica legível antes de mudar) ---- */
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-block]')];
  const rails = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail]')];
  const smooth = (a: number, b: number, x: number) => { const t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
  let progress = 0, current = -1;
  const update = () => {
    const vh = innerHeight;
    const mobile = innerWidth < 760;
    let p = 0;
    for (let i = 1; i < blocks.length; i++) {
      const top = blocks[i].getBoundingClientRect().top;
      // a transição para o capítulo i acontece enquanto o texto dele sobe de 85% a 30% da tela
      p += mobile ? smooth(vh * 0.6, vh * 0.2, top) : smooth(vh * 0.85, vh * 0.3, top);
    }
    progress = p;
    field.setProgress(p);
    const idx = Math.round(p);
    story.classList.toggle('in-chapters', p > 0.5);
    if (idx !== current) {
      current = idx;
      rails.forEach((a, i) => (i === idx ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
      canvas.setAttribute('aria-label', idx === 0 ? art0 : artText[idx - 1]);
      blocks.forEach((b, i) => b.classList.toggle('is-active', i === idx));
    }
  };
  let ticking = false;
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
